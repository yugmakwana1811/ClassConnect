{
  "name": "edugrade-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run db:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify-demo": "tsx scripts/verify-demo-data.ts",
    "db:test-demo": "tsx scripts/test-demo-seed.ts",
    "qa:demo": "tsx scripts/start-demo-qa.ts",
    "db:studio": "npm run db:sync && prisma studio",
    "db:sync": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.43.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "effect": "3.20.0",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "prisma@6.19.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
